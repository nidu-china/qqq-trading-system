# QQQ 0DTE 交易系统配置示例
# 复制为 .env 后填写真实值；不要提交包含密钥的 .env。
# 时间按 America/New_York；比例用小数，例如 0.25 表示 25%。
# Compose 会覆盖 DATABASE_URL、DATA_DIR、REPORT_DIR 为容器内地址。

# ═══════════════════════════════════════════════════════════
# 应用基础设置
# ═══════════════════════════════════════════════════════════
# 运行模式：paper=模拟成交，live=真实交易，replay=历史回放。
TRADING_MODE=paper
# 策略模式：boll_macd=布林/MACD振荡策略, trend=ORB趋势跟踪策略, hybrid=自适应双引擎策略。
STRATEGY_MODE=hybrid
# PaperBroker 初始权益，单位 USD。
PAPER_STARTING_EQUITY=10000
# Longbridge 实盘账户 ID；live 必填，paper/replay 可留空。
ACCOUNT_ID=
# 交易标的。
UNDERLYING_SYMBOL=QQQ.US

# ═══════════════════════════════════════════════════════════
# 数据库
# ═══════════════════════════════════════════════════════════
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=root-change-me
DATABASE_URL=mysql+asyncmy://qqq:change-me@127.0.0.1:3306/qqq?charset=utf8mb4

# ═══════════════════════════════════════════════════════════
# 数据、日志与 API
# ═══════════════════════════════════════════════════════════
DATA_DIR=./data/market
REPORT_DIR=./data/reports
LOG_DIR=logs
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# 可选 Bearer Token；为空不鉴权。
API_TOKEN=
SCHEDULER_POLL_SECONDS=1
# 每日自动生成报告的美东时间。
REPORT_AT=16:15:00

# ═══════════════════════════════════════════════════════════
# Longbridge API 密钥
# ═══════════════════════════════════════════════════════════
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
LONGBRIDGE_REQUEST_TIMEOUT_SECONDS=60

# ═══════════════════════════════════════════════════════════
# VIX 波动率过滤（所有策略共用）
# ═══════════════════════════════════════════════════════════
VOLATILITY_FILTER_ENABLED=true
VOLATILITY_SYMBOL=.VIX.US
VOLATILITY_LOOKBACK_DAYS=20
VOLATILITY_MAX_STALENESS_MINUTES=10
VOLATILITY_RISK_OFF_PERCENTILE=0.80
VOLATILITY_RECOVERY_PERCENTILE=0.65
VOLATILITY_RISE_5M=0.02
VOLATILITY_RISE_15M=0.03
VOLATILITY_FALL_5M=-0.02
VOLATILITY_FALL_15M=-0.03
VOLATILITY_SHOCK_5M=0.08
VOLATILITY_SHOCK_15M=0.12

# ═══════════════════════════════════════════════════════════
# BOLL/MACD 策略参数（STRATEGY_MODE=boll_macd 专用）
# ═══════════════════════════════════════════════════════════
# 时间窗口（ET），格式 HH:MM:SS
# 开盘爆量策略起始时间。
TIMED_OPENING_START=09:40:00
# 开盘爆量最后一个信号时间。
TIMED_OPENING_LAST_SIGNAL=09:45:00
# 开盘仓位无条件清仓时间。
TIMED_OPENING_FLAT=09:55:00
# 主时段开始时间。
TIMED_MAIN_START=10:00:00
# 主时段最后一个信号时间。
TIMED_MAIN_LAST_SIGNAL=12:00:00
# 布林带周期。
TIMED_BOLL_PERIOD=20
# 布林带标准差倍数。
TIMED_BOLL_STDDEV=2
# MACD 快线周期。
TIMED_MACD_FAST=8
# MACD 慢线周期。
TIMED_MACD_SLOW=17
# MACD 信号线周期。
TIMED_MACD_SIGNAL=9
# RSI 周期。
TIMED_RSI_PERIOD=14
# Call 方向 RSI 超买阈值。
TIMED_CALL_RSI_MAX=70
# Put 方向 RSI 超卖阈值。
TIMED_PUT_RSI_MIN=30
# 成交量均线回看根数。
TIMED_VOLUME_LOOKBACK=20
# 入场量比门槛。
TIMED_VOLUME_RATIO=1.2
# VIX 方向对量比门槛的调整幅度。
TIMED_VIX_VOLUME_ADJUSTMENT=0.10
# VIX 5分钟趋势判定最小变化率。
TIMED_VIX_TREND_MIN_CHANGE=0.005
# 中轨穿越检测回看根数。
TIMED_TREND_CROSS_LOOKBACK=20
# 允许的最大中轨穿越次数。
TIMED_TREND_MAX_CROSSES=2
# 趋势延续再入场：价格距中轨最大倍数。
TIMED_CONTINUATION_MAX_BAND_EXTENSION=1.20
# 趋势延续再入场：MACD 新穿越时量比乘数。
TIMED_CONTINUATION_FRESH_MACD_VOLUME_MULTIPLIER=1.20
# 普通入场 cross2 价格距中轨最大倍数。
TIMED_NORMAL_CROSS2_MAX_BAND_EXTENSION=1.20
# 普通入场 MACD 新穿越时量比乘数。
TIMED_NORMAL_FRESH_MACD_VOLUME_MULTIPLIER=1.20
# MACD 反转退出最少确认根数。
TIMED_REVERSAL_MIN_BARS=3
# MACD 反转退出确认窗口。
TIMED_REVERSAL_WINDOW=5

# ═══════════════════════════════════════════════════════════
# Trend ORB 策略参数（STRATEGY_MODE=trend 专用）
# ═══════════════════════════════════════════════════════════
# OR 窗口起始/结束时间（ET），格式 HH:MM:SS。
TREND_OR_START=09:30:00
TREND_OR_END=09:40:00
# 入场截止时间（ET）。
TREND_ENTRY_END=11:30:00
# EMA 快/慢线周期。
TREND_EMA_FAST=9
TREND_EMA_SLOW=21
# 突破确认需要的连续根数。
TREND_BREAKOUT_CONFIRM_BARS=3
# VWAP 最大交叉次数；超过此值标记为震荡日，不交易。
TREND_MAX_VWAP_CROSSES=3
# EMA 退出确认需要的连续根数。
TREND_EMA_EXIT_BARS=2

# ═══════════════════════════════════════════════════════════
# 仓位与风控（所有策略共用）
# ═══════════════════════════════════════════════════════════
# 单笔权利金最多占账户权益比例；范围 (0, 0.5]。
MAX_PREMIUM_FRACTION=0.50
# 单次开仓最多合约张数。
MAX_CONTRACTS=10
# 每个交易日最大开仓次数。
MAX_TRADES_PER_DAY=5
# 完全平仓后的冷却时间，单位分钟。
COOLDOWN_MINUTES=3
# 每张期权单边手续费估算，单位 USD。
FEE_PER_CONTRACT=1.50
# 限价追价和仓位预算使用的报价滑点，单位 USD。
SLIPPAGE_QUOTE=0.02

# ═══════════════════════════════════════════════════════════
# 离场规则（所有策略共用）
# ═══════════════════════════════════════════════════════════
# 期权止损比例；0.25 表示下跌 25%。
OPTION_STOP_LOSS_PCT=0.25
# 第一止盈阈值；1.0 表示盈利 100%。
TP1_PROFIT_PCT=1.0
# 第二止盈阈值；必须高于 TP1。
TP2_PROFIT_PCT=2.5
# 持仓超过该分钟数且仍亏损时触发 stale_position。
STALE_MINUTES=20

# ═══════════════════════════════════════════════════════════
# 期权流动性过滤（所有策略共用）
# ═══════════════════════════════════════════════════════════
MAX_SPREAD_RATIO=0.10
MAX_SPREAD_ABSOLUTE=0.20
MIN_OPEN_INTEREST=100
MIN_OPTION_VOLUME=10
# 候选行权价相对 QQQ 现价的上下范围，单位 USD。
STRIKE_OFFSET=2

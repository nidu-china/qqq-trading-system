# QQQ 0DTE 交易系统配置示例
# 复制为 .env 后填写真实值；不要提交包含密钥的 .env。
# 时间按 America/New_York；比例用小数，例如 0.25 表示 25%。
# Compose 会覆盖 DATABASE_URL、DATA_DIR、REPORT_DIR 为容器内地址。

# 应用标识；用于日志和运行时识别。
APP_NAME=qqq-0dte-trader

# 应用与运行模式
# 运行模式：paper=模拟成交，live=真实交易，replay=历史回放。
TRADING_MODE=paper
# 策略模式：boll_macd=布林/MACD振荡策略, trend=ORB趋势跟踪策略, hybrid=混合模式。
STRATEGY_MODE=trend
# PaperBroker 初始权益，单位 USD。
PAPER_STARTING_EQUITY=10000
# Longbridge 实盘账户 ID；live 必填，paper/replay 可留空。
ACCOUNT_ID=
# 交易标的；当前策略默认 QQQ.US。
UNDERLYING_SYMBOL=QQQ.US

# MySQL
# Compose 创建 qqq 数据库用户的密码。
MYSQL_PASSWORD=change-me
# Compose 创建 MySQL root 用户的密码。
MYSQL_ROOT_PASSWORD=root-change-me
# SQLAlchemy 异步连接串；本机用 127.0.0.1，Compose 自动覆盖为 mysql 容器。
DATABASE_URL=mysql+asyncmy://qqq:change-me@127.0.0.1:3306/qqq?charset=utf8mb4

# 数据、报告、日志和 API
# Parquet 行情根目录，保存 QQQ、VIX 和期权行情。
DATA_DIR=./data/market
# 日报输出目录，按日期生成 JSON、HTML、Markdown 和 SVG。
REPORT_DIR=./data/reports
# 滚动日志目录。
LOG_DIR=logs
# 日志等级：DEBUG、INFO、WARNING 或 ERROR。
LOG_LEVEL=INFO
# FastAPI 监听地址；Docker 或局域网访问使用 0.0.0.0。
API_HOST=0.0.0.0
# FastAPI 监听端口，也是 Compose 默认对外端口。
API_PORT=8000
# 可选 Bearer Token；为空不鉴权；内置 Vue 页面目前没有 Token 输入框。
API_TOKEN=
# 交易主循环轮询间隔，单位秒；必须大于 0。
SCHEDULER_POLL_SECONDS=1
# 每日自动生成报告的美东时间，格式 HH:MM:SS。
REPORT_AT=16:15:00

# Longbridge API 密钥认证
# Longbridge App Key；paper 模式也需要它获取实时行情。
LONGBRIDGE_APP_KEY=
# Longbridge App Secret；与 App Key 配套。
LONGBRIDGE_APP_SECRET=
# Longbridge Access Token；严禁提交到版本库。
LONGBRIDGE_ACCESS_TOKEN=
# Longbridge 历史K线和订阅请求超时，单位秒。
LONGBRIDGE_REQUEST_TIMEOUT_SECONDS=60

# 指标与图表分析
# Settings/API 参数页读取这些字段；生产分时策略阈值仍由 policy.py 的固定 RULES 控制。
# 布林带周期；至少为 2。
BOLLINGER_PERIOD=20
# 布林带标准差倍数；必须大于 0。
BOLLINGER_STDDEV=2
# RSI 周期；至少为 2。
RSI_PERIOD=14
# RSI 超买线；必须高于超卖线且小于 100。
RSI_OVERBOUGHT=70
# RSI 超卖线；必须大于 0 且低于超买线。
RSI_OVERSOLD=30
# EMA 快线周期；必须小于慢线周期。
EMA_FAST_PERIOD=9
# EMA 慢线周期；Settings 默认值为 20。
EMA_SLOW_PERIOD=20
# 1分钟 MACD 快线周期；必须小于慢线周期。
MACD_1M_FAST=5
# 1分钟 MACD 慢线周期。
MACD_1M_SLOW=10
# 1分钟 MACD 信号线周期。
MACD_1M_SIGNAL=3
# ADX 周期；当前为分析/扩展保留字段。
ADX_PERIOD=14
# ATR 周期；当前为分析/扩展保留字段。
ATR_PERIOD=14

# VIX 方向过滤
# 启用 VIX 状态过滤，并控制 VIX 实时K线采集。
VOLATILITY_FILTER_ENABLED=true
# 波动率标的；Longbridge VIX 默认代码 .VIX.US。
VOLATILITY_SYMBOL=.VIX.US
# VIX 历史分位回看交易日数量；至少为 5。
VOLATILITY_LOOKBACK_DAYS=20
# VIX 数据最大允许滞后，单位分钟。
VOLATILITY_MAX_STALENESS_MINUTES=10
# 进入 risk-off 的历史分位阈值，范围 0~1。
VOLATILITY_RISK_OFF_PERCENTILE=0.80
# 进入 recovery 的分位阈值，必须低于 risk-off。
VOLATILITY_RECOVERY_PERCENTILE=0.65
# VIX 5分钟上升阈值；0.02 表示 2%。
VOLATILITY_RISE_5M=0.02
# VIX 15分钟上升阈值。
VOLATILITY_RISE_15M=0.03
# VIX 5分钟回落阈值，必须为负数。
VOLATILITY_FALL_5M=-0.02
# VIX 15分钟回落阈值，必须为负数。
VOLATILITY_FALL_15M=-0.03
# VIX 5分钟冲击阈值，必须高于对应上升阈值。
VOLATILITY_SHOCK_5M=0.08
# VIX 15分钟冲击阈值，必须高于对应上升阈值。
VOLATILITY_SHOCK_15M=0.12

# 仓位与风控
PAPER_STARTING_EQUITY=10000
# 单笔权利金最多占账户权益比例；范围 (0, 0.5]。
MAX_PREMIUM_FRACTION=0.50
# 单次开仓最多合约张数；至少为 1。
MAX_CONTRACTS=10
# 每个交易日最大开仓次数。
MAX_TRADES_PER_DAY=5
# 完全平仓后的冷却时间，单位分钟。
COOLDOWN_MINUTES=3
# 每张期权单边手续费估算，单位 USD。
FEE_PER_CONTRACT=1.50
# 限价追价和仓位预算使用的报价滑点，单位 USD。
SLIPPAGE_QUOTE=0.02

# 离场规则
# 期权止损比例；0.25 表示下跌 25%。
OPTION_STOP_LOSS_PCT=0.25
# 第一止盈阈值；1.0 表示盈利 100%。
TP1_PROFIT_PCT=1.0
# 第二止盈阈值；2.5 表示盈利 250%，必须高于 TP1。
TP2_PROFIT_PCT=2.5
# 持仓超过该分钟数且仍亏损时触发 stale_position。
STALE_MINUTES=20

# 期权流动性过滤
# Bid/Ask 最大相对价差；0.10 表示 10%。
MAX_SPREAD_RATIO=0.10
# Bid/Ask 最大绝对价差，单位 USD。
MAX_SPREAD_ABSOLUTE=0.20
# 期权最低未平仓量 OI。
MIN_OPEN_INTEREST=100
# 期权当日最低成交量。
MIN_OPTION_VOLUME=10
# 预留目标 Delta；当前选择器尚未使用。
TARGET_DELTA=0.45
# 候选行权价相对 QQQ 现价的上下范围，单位 USD。
STRIKE_OFFSET=2

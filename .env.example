# 交易模式：paper / replay / live
TRADING_MODE=paper
STRATEGY_PROFILE=dynamic
PAPER_STARTING_EQUITY=10000
ACCOUNT_ID=
LIVE_TRADING_ACK=
UNDERLYING_SYMBOL=QQQ.US

# MySQL
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=root-change-me
DATABASE_URL=mysql+asyncmy://qqq:change-me@127.0.0.1:3306/qqq?charset=utf8mb4

# 数据、报告、日志和 API
DATA_DIR=./data/market
REPORT_DIR=./data/reports
LOG_DIR=logs
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
API_TOKEN=
SCHEDULER_POLL_SECONDS=1
REPORT_AT=16:15:00

# Longbridge：OAuth 模式只需 CLIENT_ID；密钥模式填写后三项
LONGBRIDGE_CLIENT_ID=
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
LONGBRIDGE_REQUEST_TIMEOUT_SECONDS=60

# 可编辑技术指标
BOLLINGER_PERIOD=20
BOLLINGER_STDDEV=2
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21
MACD_1M_FAST=5
MACD_1M_SLOW=10
MACD_1M_SIGNAL=3
ADX_PERIOD=14
ATR_PERIOD=14

# VIX 方向过滤
VOLATILITY_FILTER_ENABLED=true
VOLATILITY_SYMBOL=.VIX.US
VOLATILITY_LOOKBACK_DAYS=20
VOLATILITY_MAX_STALENESS_MINUTES=10
VOLATILITY_RISK_OFF_PERCENTILE=0.80
VOLATILITY_RECOVERY_PERCENTILE=0.65
VOLATILITY_RISE_5M=0.02
VOLATILITY_RISE_15M=0.03
VOLATILITY_FALL_5M=-0.02
VOLATILITY_FALL_15M=-0.03
VOLATILITY_SHOCK_5M=0.08
VOLATILITY_SHOCK_15M=0.12

# 仓位与风控
MAX_PREMIUM_FRACTION=0.05
MAX_CONTRACTS=10
MAX_TRADES_PER_DAY=5
COOLDOWN_MINUTES=5
DAILY_LOSS_LIMIT=0.02
FEE_PER_CONTRACT=1.50
SLIPPAGE_QUOTE=0.02

# 离场规则
OPTION_STOP_LOSS_PCT=0.25
TP1_PROFIT_PCT=1.0
TP2_PROFIT_PCT=2.5
TRAILING_ATR_MULTIPLIER=0.5
STALE_MINUTES=30

# 期权流动性过滤
MAX_SPREAD_RATIO=0.10
MAX_SPREAD_ABSOLUTE=0.20
MIN_OPEN_INTEREST=100
MIN_OPTION_VOLUME=10
TARGET_DELTA=0.45

# 分时趋势策略参数
TIMED_OPENING_VOLUME_RATIO=2.0
TIMED_OPENING_RANGE_RATIO=0.75
TIMED_OPENING_BODY_RATIO=0.65
TIMED_OPENING_CLOSE_EXTREME=0.35
TIMED_PULLBACK_TOUCH_ATR=0.15
TIMED_PULLBACK_MAX_EXTENSION_ATR=0.60
TIMED_REJECTION_CLOSE_RATIO=0.65
TIMED_SLOW_EMA_PERIOD=21
